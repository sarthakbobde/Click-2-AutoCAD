# Copy the lines you need into .env. Edits to .env apply to the next job; no restart needed.
# Keep real keys only in .env, never in this file.

# live: Claude, in a Claude Code session next to the app, writes each script (no API key needed)
# api:  the Anthropic API writes it (needs ANTHROPIC_API_KEY)
C2C_CLAUDE_MODE=live

# api mode only: key from the Claude Console (platform.claude.com), billed there
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

C2C_MAX_PARALLEL_JOBS=2
C2C_JOB_TIMEOUT_SECONDS=1800
